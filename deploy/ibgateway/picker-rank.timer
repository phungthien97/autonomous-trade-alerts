[Unit]
Description=Biweekly S&P picker ranking (every other Sat via weekly fire + CLI window)

[Timer]
# systemd has no portable "every other Saturday" expression, so we fire every
# Saturday ~00:00 Eastern and let app/picker_rank.py enforce biweekly
# (BIWEEKLY_SKIP_WITHIN_DAYS=10). Skips email + write last_rank_status.json.
# Host clock is UTC; 04:00 UTC = midnight EDT (winter EST ≈ 05:00 UTC).
# Force: PICKER_FORCE=1 or python -m app.picker_rank --force
OnCalendar=Sat *-*-* 04:00:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
