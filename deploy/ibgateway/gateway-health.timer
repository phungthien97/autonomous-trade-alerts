[Unit]
Description=Gateway health with API probe (hourly + after Auto-Restart)

[Timer]
# Shortly after AutoRestartTime=11:45 PM UTC
OnCalendar=*-*-* 00:15:00
# Hourly API liveness — catch zombie Gateway (port up, session dead)
OnCalendar=hourly
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
