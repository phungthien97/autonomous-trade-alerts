[Unit]
Description=Live trading cycle (broker_paper)
After=ibgateway.service network.target
Wants=ibgateway.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/autonomous-trade-alerts
Environment=DISPLAY=:1
EnvironmentFile=-/opt/autonomous-trade-alerts/.env
ExecStart=/opt/autonomous-trade-alerts/.venv/bin/python -m app.live_worker --mode broker_paper --broker ibkr
